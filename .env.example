# Copy to .env.local. Never commit real credentials.
# At least 12 characters. Admin stays disabled until configured.
ADMIN_PASSWORD=
# Optional separate signing secret: use at least 32 random characters.
ADMIN_SESSION_SECRET=
# Local dev writes by default. Enable only on a persistent self-hosted Node server.
# Vercel always uses downloadable exports instead of filesystem writes.
CONTENT_WRITE_ENABLED=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
# Optional HTTPS endpoint receiving JSON {name,email,message}. Without it, contact opens an email draft.
CONTACT_WEBHOOK_URL=
# Fill with your approved publisher and slot IDs. Ads remain disabled without valid values.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_ARTICLE_SLOT=
NEXT_PUBLIC_ADSENSE_HOME_SLOT=
# Ad loading requires a verified external certified consent platform integration.
NEXT_PUBLIC_ADSENSE_CMP_READY=false
